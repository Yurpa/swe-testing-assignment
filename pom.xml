<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.quickcalc</groupId>
    <artifactId>quick-calc</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>IntCALC — Quick Calculator</name>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependency versions — bump here to update everywhere -->
        <junit.version>5.10.2</junit.version>
        <assertj-swing.version>3.17.1</assertj-swing.version>
        <surefire.version>3.2.5</surefire.version>
    </properties>

    <dependencies>

        <!-- ================================================================
             TEST-SCOPE DEPENDENCIES
             ================================================================ -->

        <!-- JUnit 5 API — used in test source files -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5 Engine — needed by Surefire to actually run the tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
            AssertJ Swing (formerly FEST-Swing) for integration / GUI tests.
            The -junit5 artifact brings in the JUnit 5 extension automatically.
        -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-swing-junit</artifactId>
            <version>${assertj-swing.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- ============================================================
                 Maven Surefire Plugin — test runner
                 Run all tests with:  mvn test
                 ============================================================ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <!--
                        Integration tests open a real Swing window.
                        On headless CI servers add: -Djava.awt.headless=false
                        or point DISPLAY to an Xvfb instance.
                    -->
                    <systemPropertyVariables>
                        <java.awt.headless>false</java.awt.headless>
                    </systemPropertyVariables>

                    <!-- Include both unit and integration test classes -->
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                    </includes>
                </configuration>
            </plugin>

            <!-- ============================================================
                 Maven Compiler Plugin — explicit Java 11 compilation
                 ============================================================ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>11</source>
                    <target>11</target>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
